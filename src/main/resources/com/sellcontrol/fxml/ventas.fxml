<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sellcontrol.controller.VentaController"
            styleClass="dashboard-container">

    <!-- Barra Superior -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="toolbar">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="Módulo de Ventas" styleClass="toolbar-title">
                <font><Font size="18"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄 Refrescar" onAction="#handleRefrescar" styleClass="btn-secondary"/>
            <Button text="← Volver" onAction="#handleVolver" styleClass="btn-secondary"/>
        </HBox>
    </top>

    <!-- Contenido con pestañas -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <padding>
                <Insets top="10" right="10" bottom="0" left="10"/>
            </padding>

            <!-- Pestaña: Ventas Activas -->
            <Tab text="🛒 Ventas Activas">
                <BorderPane>
                    <top>
                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>
                            <Button text="➕ Nueva Venta" onAction="#handleNuevaVentaTab" styleClass="btn-primary"/>
                            <Label text="Puede mantener abiertas múltiples ventas independientes y cobrarlas por separado." styleClass="status-label"/>
                        </HBox>
                    </top>
                    <center>
                        <TabPane fx:id="tabPaneActivas" tabClosingPolicy="ALL_TABS">
                            <padding>
                                <Insets top="5" right="5" bottom="5" left="5"/>
                            </padding>
                        </TabPane>
                    </center>
                </BorderPane>
            </Tab>

            <!-- Pestaña: Ventas del Día -->
            <Tab text="📋 Ventas del Día">
                <VBox spacing="10">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <TableView fx:id="tablaVentasHoy" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colVId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colVFecha" text="Fecha/Hora" prefWidth="150"/>
                            <TableColumn fx:id="colVUsuario" text="Cajero" prefWidth="130"/>
                            <TableColumn fx:id="colVTotal" text="Total" prefWidth="100"/>
                            <TableColumn fx:id="colVMetodo" text="Método" prefWidth="100"/>
                            <TableColumn fx:id="colVEstado" text="Estado" prefWidth="100"/>
                            <TableColumn fx:id="colVCliente" text="Cliente" prefWidth="130"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10">
                        <Button text="🔍 Ver Detalle" onAction="#handleVerDetalle" styleClass="btn-secondary"/>
                        <Button text="🖨️ Imprimir Ticket" onAction="#handleImprimirTicket" styleClass="btn-primary"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- Pestaña: Fiados (Pendientes) -->
            <Tab text="💳 Fiados">
                <VBox spacing="10">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <TableView fx:id="tablaFiados" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colFId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colFFecha" text="Fecha" prefWidth="150"/>
                            <TableColumn fx:id="colFCliente" text="Cliente" prefWidth="180"/>
                            <TableColumn fx:id="colFTotal" text="Total" prefWidth="100"/>
                            <TableColumn fx:id="colFUsuario" text="Cajero" prefWidth="130"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10">
                        <Button text="💰 Cobrar Seleccionado" onAction="#handleCobrarFiado" styleClass="btn-primary"/>
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <!-- Barra inferior -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" styleClass="action-bar">
            <padding>
                <Insets top="8" right="20" bottom="8" left="20"/>
            </padding>
            <Label fx:id="lblMensaje" text="" styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>
